# Local llama.cpp / Qwen paths. These are relative to backend/ and portable.
LLAMA_SERVER_PATH=llama-server/llama-server.exe
LLM_MODEL_PATH=../models/qwen3-4b-thinking.gguf
LLAMA_SERVER_HOST=127.0.0.1
LLAMA_SERVER_PORT=8080
LLAMA_CTX_SIZE=4096
LLAMA_GPU_LAYERS=99
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=220

# Prebuilt local hybrid RAG: preserves models/chromadb and models/bm25_index.pkl.
RAG_BACKEND=chroma
CHROMA_PERSIST_DIRECTORY=../models/chromadb
CHROMA_COLLECTION_NAME=medical_rag_vi
BM25_INDEX_PATH=../models/bm25_index.pkl
EMBEDDING_MODEL_NAME=Dqdung205/medical_vietnamese_embedding
EMBEDDING_DEVICE=auto

# Tavily is used as evidence fallback, or whenever Vietnamese web preference is enabled.
# Paste a new key in backend/.env, never commit that file.
TAVILY_ENABLED=true
TAVILY_API_KEY=
TAVILY_MAX_RESULTS=3
TAVILY_TIMEOUT_SECONDS=12
TAVILY_TRUSTED_DOMAINS=moh.gov.vn,benhvien108.vn,vinmec.com,medlatec.vn,tamanhhospital.vn,suckhoedoisong.vn,dailymed.nlm.nih.gov,medlineplus.gov,fda.gov,who.int,nhs.uk
TAVILY_PREFERRED_DOMAINS=moh.gov.vn,benhvien108.vn,vinmec.com,medlatec.vn,tamanhhospital.vn,suckhoedoisong.vn

# Keep the response context small and focused for Qwen and VieNeu-TTS.
RAG_MIN_EVIDENCE_CHUNKS=2
RAG_MIN_EVIDENCE_SCORE=0.62
RAG_EVIDENCE_RELEVANCE_FLOOR=0.50
RAG_TRUSTED_SOURCE_HINTS=dailymed,medlineplus
RAG_ALLOW_QUESTION_ANSWER_SOURCES=false
RAG_PREFER_VIETNAMESE_WEB=false
RAG_CONTEXT_MAX_CHUNKS=2
RAG_CONTEXT_CHARS_PER_CHUNK=900
LLM_MAX_RESPONSE_CHARS=800

# ASR: custom Wav2Vec2 CTC -> KenLM + drug hotwords -> ViT5 rewrite.
ASR_MODEL_PATH=../models/asr/best_model_hf
ASR_KENLM_PATH=models/kenlm/kenlm_vi_medical_4gram.bin
ASR_VIT5_MODEL_PATH=../models/kenlm+vit5/vit5_medical_rewrite_stage2_final
ASR_HOTWORDS_PATH=../text/drugs.txt
ASR_REQUIRE_KENLM=false
ASR_USE_GPU=true
# Keep false for the tested Tesla P40 + CUDA 12/cuDNN 9 combination.
ASR_WAV2VEC2_USE_GPU=false
ASR_BEAM_WIDTH=16
ASR_BEAM_PRUNE_LOGP=-5.0
ASR_TOKEN_MIN_LOGP=-3.0
ASR_MAX_REWRITE_TOKENS=64

# VieNeu-TTS keeps UTF-8 and the expected WAV name.
TTS_ENABLED=true
TTS_OUTPUT_FILENAME=vieneu-tts-l-cystine-utf8.wav

# Avoid spending the whole token budget in Qwen3's hidden reasoning trace.
LLAMA_CHAT_TEMPLATE_FILE=templates/qwen3_no_think.jinja
LLAMA_REASONING=off
LLAMA_REASONING_BUDGET=0
